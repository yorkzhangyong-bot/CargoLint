# Copy to .env (or set as OS environment variables). Never commit .env.
OPENROUTER_API_KEY=                 # required: OpenRouter API key (chat + embeddings)
OPENROUTER_HTTP_REFERER=            # optional: app URL sent as HTTP-Referer for OpenRouter attribution
OPENROUTER_APP_TITLE=CargoLint      # optional: app name sent as X-OpenRouter-Title
CARGOLINT_CHAT_MODEL=openai/gpt-4o-mini          # chat model id on OpenRouter
CARGOLINT_EMBED_MODEL=qwen/qwen3-embedding-8b    # embedding model id on OpenRouter (must match the built index)
CARGOLINT_STRUCTURED_METHOD=json_schema          # json_schema | function_calling
CARGOLINT_USD_EUR=0.92              # USD -> EUR rate used for the cost display
CARGOLINT_WORKERS=4                 # parallel lines per batch tool
CARGOLINT_OCR_MIN_SCORE=0.6         # OCR lines with a lower mean score are marked unreadable
CARGOLINT_RELEASE_REPO=             # feature 013: owner/name of the repository whose releases hold the knowledge base; empty: no release fetch
CARGOLINT_EBTI_RELEASE=             # optional pin of an EBTI release (ebti-YYYY-MM-DD) for a rollback; empty: the newest
CARGOLINT_TARIC_RELEASE=            # optional pin of a TARIC release (taric-YYYY-MM-DD); empty: the newest
CARGOLINT_EBTI_RULINGS=5000         # the EBTI store size of a refresh: a positive integer, or all for every valid ruling
